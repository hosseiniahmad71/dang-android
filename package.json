{
  "name": "dong-android-offline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/server.mjs",
    "start": "node server/server.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "test:ui-contract": "node tests/check-ui-syntax.cjs && node --test tests/ui-contract.test.cjs",
    "test:audit": "node tests/verify-ui-and-report.mjs",
    "build:android": "tsc -b && vite build && node scripts/copy-to-android.mjs",
    "test:native": "node --test tests/native-runtime.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.0",
    "typescript": "~5.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
